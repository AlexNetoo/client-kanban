# Generate real values with:  npm run setup
# Freelancer (full access) password hash. Required.
APP_PASSWORD_HASH=
# Optional: separate password for clients (read-only, one project per link).
CLIENT_PASSWORD_HASH=
# Random string, 32+ chars. Signs session cookies. Required.
SESSION_SECRET=
# Optional
PORT=3000
SESSION_HOURS=12
DATA_FILE=./data/db.json
# Set true behind HTTPS (default: true when NODE_ENV=production)
COOKIE_SECURE=
# Set true if behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=
