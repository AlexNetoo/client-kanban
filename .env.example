# Generate real values with:  npm run setup
# Admin password hash (sign in at /admin). Required.
APP_PASSWORD_HASH=
# Random string, 32+ chars. Signs session cookies. Required.
SESSION_SECRET=
# Optional
# Fill a brand-new, empty database with sample projects (demo only; leave unset in production)
# SEED_DEMO_DATA=true
PORT=3000
SESSION_HOURS=12
DATA_FILE=./data/db.json
# Set true behind HTTPS (default: true when NODE_ENV=production)
COOKIE_SECURE=
# Set true if behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=
