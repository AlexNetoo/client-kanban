{
  "functions": {
    "api/index.js": {
      "includeFiles": "{web/**,server/**}",
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "0 7 * * *" }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
